# Development Environment (Example)
# Copy this file to .env.active and update with your actual values
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Development Database
# For SQLite (Local): DATABASE_URL="file:./dev.db"
# For PostgreSQL (Supabase): DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL="file:./dev.db"

# Development NextAuth URL (for Codespaces/local development)
NEXTAUTH_URL="http://localhost:3000"

# Development JWT secret (CHANGE THIS!)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Development mode
NODE_ENV="development"
