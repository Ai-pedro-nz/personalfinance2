# Supabase Environment Configuration (Example)
# For local development using Supabase instead of SQLite
# Copy this file to .env.active when you want to use Supabase locally

# Supabase Database (PostgreSQL with Connection Pooling)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection Pooling
# IMPORTANT: Use port 6543 (connection pooler), not 5432!
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Development URL (for Codespaces/local development)
NEXTAUTH_URL="http://localhost:3000"

# Development JWT secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Development mode
NODE_ENV="development"

# Connection Pooling Notes:
# - pgbouncer=true: Required for connection pooling with Supabase
# - connection_limit=1: Prevents "too many connections" errors in serverless
# - Port 6543: Connection pooler (REQUIRED for application)
# - Port 5432: Direct connection (use ONLY for migrations/admin tasks)
