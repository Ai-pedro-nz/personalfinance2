# Production Environment Configuration (Example)
# Copy this file to .env.production and update with your actual values

# Production Database (Supabase/PostgreSQL)
# Use Connection Pooling URL (port 6543) for better performance
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Production URL (your Vercel deployment URL)
NEXTAUTH_URL="https://your-app.vercel.app"

# Production JWT Secret (MUST be different from development!)
# Generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-secure-random-string-at-least-32-characters"

# Production mode
NODE_ENV="production"
